@model ParticipantHomeViewModel
@{ ViewData["Title"] = "Browse events"; }
<section class="rd-hero rd-hero-sm">
    <div class="rd-hero-inner">
        <p class="rd-kicker">Find your next race</p>
        <h1 class="rd-hero-title sm">Upcoming <em>events</em></h1>
    </div>
</section>

<form method="get" asp-action="Index" class="rd-filter card rd-card p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small" for="search">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="type">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="" selected="@string.IsNullOrEmpty(Model.Type)">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">🏃 Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">🚶 Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">🚴 Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small" for="when">When</label>
            <select id="when" name="when" class="form-select">
                <option value="upcoming" selected="@(Model.When != "all")">Upcoming</option>
                <option value="all" selected="@(Model.When == "all")">All dates</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn rd-btn flex-fill" type="submit">Filter</button>
            <a class="btn rd-btn-outline" asp-action="Index" title="Clear filters">✕</a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-center-card text-center">
        <div class="rd-big-emoji">🔍</div>
        <h2 class="rd-heading">No events match</h2>
        <p class="text-muted mb-0">Try a different search or switch to “All dates”.</p>
    </div>
}
else
{
    <div class="row g-4">
    @foreach (var ev in Model.Events)
    {
        <div class="col-md-6 col-xl-4">
            @{ ViewData["Enrolled"] = Model.EnrolledEventIds.Contains(ev.Id); }
            <partial name="_EventCard" model="ev" />
        </div>
    }
    </div>
}
