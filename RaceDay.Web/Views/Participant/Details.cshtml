@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Name;
    var ev = Model.Event;
    var past = ev.Date < DateTime.Now;
    var active = Model.MyEnrolment is not null && Model.MyEnrolment.Status != "Cancelled";
}
<nav class="rd-crumbs"><a asp-action="Index">Browse events</a> / <span>@ev.Name</span></nav>

<div class="card rd-card overflow-hidden mb-4">
    <div class="detail-banner-wrap">
        @{ ViewData["Class"] = "detail-banner"; }
        <partial name="_EventBanner" model="ev" />
        <span class="type-chip">@Display.Icon(ev.EventType) @ev.EventType</span>
    </div>
    <div class="card-body p-4">
        <h1 class="rd-heading">@ev.Name</h1>
        <div class="row g-3 my-2">
            <div class="col-md-4"><div class="fact"><span>📅 Date</span><strong>@Display.Date(ev.Date)</strong></div></div>
            <div class="col-md-4"><div class="fact"><span>📍 Location</span><strong>@ev.Location</strong></div></div>
            <div class="col-md-4"><div class="fact"><span>📏 Distance</span><strong>@Display.Distance(ev.DistanceKm)</strong></div></div>
        </div>
        <p class="mt-3 mb-0" style="white-space:pre-line">@ev.Description</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card rd-card">
            <div class="card-header rd-card-header">Available categories</div>
            @if (Model.Categories.Count == 0)
            {
                <div class="card-body text-muted">The organiser hasn't added categories yet. Check back soon.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                @foreach (var c in Model.Categories)
                {
                    <li class="list-group-item">
                        <strong>@c.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(c.Description)) { <div class="text-muted small">@c.Description</div> }
                    </li>
                }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card rd-card enter-card">
            <div class="card-header rd-card-header">Enter this event</div>
            <div class="card-body">
                @if (active)
                {
                    <p class="mb-2">You're entered in <strong>@Model.MyEnrolment!.CategoryName</strong>.</p>
                    <p class="mb-3">Status: <partial name="_StatusBadge" model="Model.MyEnrolment.Status" /></p>
                    <a class="btn rd-btn-outline w-100" asp-action="MyEvents">Go to my events</a>
                }
                else if (past)
                {
                    <p class="text-muted mb-0">This event has already taken place, so entries are closed.</p>
                }
                else if (Model.Categories.Count == 0)
                {
                    <p class="text-muted mb-0">Entries open once categories are added.</p>
                }
                else
                {
                    <form asp-action="Enrol" method="post">
                        <input type="hidden" name="eventId" value="@ev.Id" />
                        <label for="categoryId" class="form-label">Choose your category</label>
                        <select id="categoryId" name="categoryId" class="form-select mb-3" required>
                            <option value="">Select a category…</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                        <button type="submit" class="btn rd-btn w-100">Enter event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
