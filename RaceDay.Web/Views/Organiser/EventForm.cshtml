@model EventFormViewModel
@{ ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event"; }
<div class="rd-form-card">
    <h1 class="rd-heading">@(Model.IsEdit ? "Edit event" : "Create event")</h1>
    <form method="post" enctype="multipart/form-data" asp-action="@(Model.IsEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@(Model.IsEdit ? Model.Id : (int?)null)" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="IsEdit" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Date" class="form-label">Date &amp; time</label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" />
                <span asp-validation-for="DistanceKm" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">🏃 Run</option>
                    <option value="Walk">🚶 Walk</option>
                    <option value="Cycle">🚴 Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="banner-preview" /></div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif" />
                <div class="form-text">JPG, PNG, WEBP or GIF up to 5 MB. @(Model.IsEdit ? "Choose a file to replace the current banner." : "Shown on the event page.")</div>
                <span asp-validation-for="Banner" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn rd-btn">@(Model.IsEdit ? "Save changes" : "Create event")</button>
            <a class="btn rd-btn-outline" asp-action="Events">Cancel</a>
        </div>
    </form>
</div>
