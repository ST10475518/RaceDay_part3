@inject ApiClient Api
@{
    var role = Context.Session.GetString(SessionKeys.Role);
    var name = Context.Session.GetString(SessionKeys.Name);
    var picture = Api.ResolveImage(Context.Session.GetString(SessionKeys.Picture));
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, params string[] actions) =>
        controller == c && (actions.Length == 0 || actions.Contains(action)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "RaceDay") · RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg rd-navbar">
    <div class="container">
        <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (role == Roles.Organiser)
                {
                    <li class="nav-item"><a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Organiser", "Events", "EditEvent", "Categories", "Enrolments", "Results")" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Organiser", "CreateEvent")" asp-controller="Organiser" asp-action="CreateEvent">Create Event</a></li>
                }
                else if (role == Roles.Participant)
                {
                    <li class="nav-item"><a class="nav-link @Active("Participant", "Index", "Details")" asp-controller="Participant" asp-action="Index">Browse Events</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                @if (role is not null)
                {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @Active("Profile")" asp-controller="Profile" asp-action="Index">
                            @if (!string.IsNullOrEmpty(picture))
                            {
                                <img src="@picture" alt="" class="rd-avatar" />
                            }
                            else
                            {
                                <span class="rd-avatar rd-avatar-fallback">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper())</span>
                            }
                            <span>@name <span class="rd-role-pill">@role</span></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm rd-btn-outline">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-sm rd-btn" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4 rd-main">
    @foreach (var (key, css) in new[] { ("Success", "success"), ("Error", "danger"), ("Warning", "warning") })
    {
        if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
        {
            <div class="alert alert-@css alert-dismissible fade show rd-alert" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    }
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container d-flex flex-wrap justify-content-between">
        <span class="rd-brand small">RACE<span>DAY</span></span>
        <span class="text-muted small">Run. Walk. Ride. Every finish line counts.</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
